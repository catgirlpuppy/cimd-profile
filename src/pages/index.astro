---
import Main from "../layouts/main.astro";
import Social from "../components/social.astro";

const socials = [
  {
    hover: "@catgirlpuppy",
    icon: "fa7-brands:github",
    link: "https://github.com/catgirlpuppy",
  },

  {
    hover: "@catgirlpup",
    icon: "fa7-brands:discord",
    link: "https://discord.com/users/1408956378600702042",
  },
  {
    hover: "@catgirlpuppy.01",
    icon: "fa7-brands:signal-messenger",
    link: "https://signal.me/#eu/Yj2KIwG3CTRCPVOJPg7bm_Mmagzpjq17UnbhWO3buIVFRpti6-RJmJZxrgISZDgo",
  },
  {
    hover: "@catgirlpuppy",
    icon: "fa7-brands:twitter",
    link: "https://twitter.com/catgirlpuppy",
  },
];
---

<Main title="Charlotte's website :3">
  <div class="bg-background/40 w-full flex-row gap-4 rounded-xl p-4 backdrop-blur-2xl md:w-208">
    <div class="flex w-full flex-row items-center gap-2 pb-4">
      <img
        src="/img/pfp.jpg"
        alt="Charlotte's profile picture"
        class="h-28 w-28 rounded-full"
      />
      <div>
        <h1>Charlotte</h1>
        <p>
          <span>it/its/she/her &bullet; </span><span
            class="font-semibold"
            id="username"
          >
            @catgirlpuppy
          </span>
        </p>
        <div class="text-ctp-subtext1 flex flex-row gap-0.5 text-3xl">
          {socials.map((social) => <Social {...social} />)}
        </div>
      </div>
    </div>

    <div>
      <h2>about me</h2>
      <p>hi, i'm Charlotte, a sixteen-year-old puppygirl. :3</p>
      <p>i'm taken!! :) i'm also a furry, and my <span class="text-ctp-subtext0">self-named</span> fursona <span class="text-ctp-subtext0">(which is part-cat, part-dog)</span> is loosely based off the colours of the monster ultra fantasy ruby red can. my favourite colours are pink and purple.</p>
      <p>i'm fairly comfortable with linux servers and desktops, and i'm overwhelmingly more interested in hardware projects than i am software/websites.</p>
    </div>

    <div>
      <h2>extras!</h2>
      <p>
        here you can see&nbsp;
        <a
          href="/projects"
          class="text-ctp-lavender"
          >my projects</a
        >
        . maybe one day, i'll make a blog. not today though :p
      </p>
      <p>my email is <span class="text-ctp-subtext0">spam@is-my.dog</span>, but you'll need to replace 'spam' with 'charlotte', else it will drop.</p>
    </div>
  </div>

  <a
    href="https://github.com/catgirlpuppy/cimd-profile"
    target="_blank"
    rel="noopener noreferrer"
    class="text-ctp-overlay2 bg-background/40 mt-4 mb-4 rounded-xl p-2 backdrop-blur-2xl md:mb-0"
  >
    made with my own two paws. <span class="text-nowrap">:3</span>
  </a>
</Main>
